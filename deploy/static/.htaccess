# Tivora static site on Apache/cPanel
Options -Indexes
DirectoryIndex index.html index.php

# https + apex domain (www.tivoraerp.com -> tivoraerp.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Films: served with byte ranges (Apache default) so seeking works. File names carry the version
# (tivora-<film>-v1-*), so a long cache is safe. mp4 stays out of DEFLATE below.
AddType video/mp4 .mp4
AddType text/vtt .vtt

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/vtt "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Hashed build files never change in place
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html

# Keep the form config (and its secrets) from being downloaded
<Files "config.php">
  Require all denied
</Files>

# Lead pipeline: worker, includes, queue data and scoring rules are never web-reachable
<FilesMatch "^(sync\.php|config\.sample\.php|lead-rules\.json)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^api/demo/(lead|data)(/|$) - [F,L]
</IfModule>
